# =============================================================================
# CryptoScope Research — environment variables
#
# Copy to .env.local for local development. NEVER commit real values.
# In production, set these in the hosting provider's environment settings
# (Render → Service → Environment), never in the repository.
#
# All variables are read server-side and validated at startup (src/lib/env.ts).
# Only NEXT_PUBLIC_* values are ever sent to the browser.
# =============================================================================

# --- Core --------------------------------------------------------------------
# development | test | staging | production. "production" enforces strict checks
# (no mock market data, no billing simulator, real email, Supabase required).
APP_ENV=development
# Public base URL of the site (used for links in emails, auth redirects, CSP/HSTS).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# debug | info | warn | error
LOG_LEVEL=info

# --- Supabase (REQUIRED for accounts, portfolios, alerts, research, billing) --
# Project Settings → API. The anon/publishable key is used server-side only in
# this app; the service-role key bypasses RLS: keep it secret, server-only.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=replace-with-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# --- Market data ---------------------------------------------------------------
# mock (development only, fictional assets) | coingecko
MARKET_DATA_PROVIDER=mock
# public (keyless, very limited) | demo | pro
COINGECKO_API_PLAN=demo
# Required for demo/pro plans. https://www.coingecko.com/en/api
COINGECKO_API_KEY=
# Optional: provider request timeout and delay between per-coin history calls.
MARKET_DATA_TIMEOUT_MS=10000
HISTORY_REFRESH_DELAY_MS=2500

# --- Token unlock data (OPTIONAL) ----------------------------------------------
# Only "none" is implemented. Staff can record cited unlock events in /admin/coins.
TOKEN_UNLOCK_PROVIDER=none

# --- Billing (OPTIONAL) --------------------------------------------------------
# none | dev_simulator (development only; never moves money; refused in production)
BILLING_PROVIDER=none
# HMAC secret for simulated webhooks (>= 32 chars) when BILLING_PROVIDER=dev_simulator.
DEV_BILLING_WEBHOOK_SECRET=

# --- Email (OPTIONAL in development, REQUIRED in production) --------------------
# console (development only: logs instead of sending) | resend
EMAIL_PROVIDER=console
RESEND_API_KEY=
# Verified sender, e.g. "CryptoScope <alerts@yourdomain.com>"
EMAIL_FROM=

# --- Telegram (OPTIONAL) -------------------------------------------------------
# From @BotFather. Server-only; never exposed to the browser.
TELEGRAM_BOT_TOKEN=
# Bot username without @ (used to build t.me deep links).
TELEGRAM_BOT_USERNAME=
# Random string >= 24 chars; pass as secret_token to setWebhook.
TELEGRAM_WEBHOOK_SECRET=

# --- AI research assistant (OPTIONAL) ------------------------------------------
# none | anthropic
AI_PROVIDER=none
ANTHROPIC_API_KEY=
# Recommended: claude-opus-5-5
AI_MODEL=
# Max output tokens per answer (includes thinking) and request timeout.
AI_MAX_OUTPUT_TOKENS=8000
AI_TIMEOUT_MS=60000

# --- Scheduled jobs (REQUIRED for jobs) ----------------------------------------
# Random string >= 32 chars. Cron callers send "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=
