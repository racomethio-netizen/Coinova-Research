// TAMAGNE database schema (PostgreSQL 16, Prisma 7).
//
// Conventions
// - Primary keys are UUIDs generated by PostgreSQL (gen_random_uuid()).
//   Public identifiers (Tamagne ID, QR token) are separate random values.
// - Identity numbers (Fayda FIN/FAN) are NEVER stored in clear and are never keys.
//   Only a keyed HMAC of the provider subject is kept, for duplicate detection.
// - Columns ending in `Enc` hold application-level AES-256-GCM ciphertext.
// - Columns ending in `Hash` hold SHA-256 / HMAC-SHA-256 digests (hex), never secrets.
// - Money is Decimal(14,2) + ISO 4217 currency. No floats.
// - Rules Prisma cannot express (CHECK constraints, partial unique indexes,
//   append-only triggers, badge-issuance guards) live in the hand-written
//   migration `*_integrity_rules`. See docs/ARCHITECTURE.md §6.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Enums ─────────────────────────────

