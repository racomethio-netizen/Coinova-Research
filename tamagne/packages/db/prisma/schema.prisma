  LOGIN
  PHONE_CHANGE
  PASSWORD_RESET
}

enum MfaFactorType {
  TOTP
}

enum SellerType {
  INDIVIDUAL
  SOCIAL_MEDIA_SELLER
  TELEGRAM_SHOP
  REGISTERED_BUSINESS
  ECOMMERCE_COMPANY
  ONLINE_SERVICE_PROVIDER
}

enum SellerAccountStatus {
  ACTIVE
  UNDER_REVIEW
  SUSPENDED
  DEACTIVATED
}

enum BusinessLegalForm {
  SOLE_PROPRIETORSHIP
