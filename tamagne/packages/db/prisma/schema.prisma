// ─────────────────────── Accounts & authentication ───────────────────────

model User {
  id               String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// E.164, private. Nulled on deletion so the number can be reused.
  phoneE164        String?    @unique @db.VarChar(16)
  phoneVerifiedAt  DateTime?  @db.Timestamptz(6)
  /// Stored lower-cased.
  email            String?    @unique @db.VarChar(254)
  /// Argon2id hash. Null for phone-OTP-only accounts.
  passwordHash     String?
  status           UserStatus @default(PENDING_PHONE_VERIFICATION)
  preferredLocale  Locale     @default(EN)
  failedLoginCount Int        @default(0)
  lockedUntil      DateTime?  @db.Timestamptz(6)
  lastLoginAt      DateTime?  @db.Timestamptz(6)
  createdAt        DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime   @updatedAt @db.Timestamptz(6)
  deletedAt        DateTime?  @db.Timestamptz(6)

  sessions              Session[]
  mfaFactors            MfaFactor[]
  roleAssignments       StaffRoleAssignment[]   @relation("RoleHolder")
  rolesGranted          StaffRoleAssignment[]   @relation("RoleGrantor")
  rolesRevoked          StaffRoleAssignment[]   @relation("RoleRevoker")
  sellerProfile         SellerProfile?
  consents              ConsentRecord[]
  oidcAuthRequests      OidcAuthRequest[]
  uploadedDocuments     BusinessDocument[]
  badgesRevoked         SellerBadge[]
  verificationEvents    VerificationEvent[]
  fraudReportsFiled     FraudReport[]           @relation("FraudReporter")
  fraudReportsAssigned  FraudReport[]           @relation("FraudAssignee")
  appealsSubmitted      Appeal[]                @relation("AppealSubmitter")
  appealsAssigned       Appeal[]                @relation("AppealAssignee")
  appealsDecided        Appeal[]                @relation("AppealDecider")
  reviewsPerformed      ReviewRecord[]          @relation("PrimaryReviewer")
  reviewsSeconded       ReviewRecord[]          @relation("SecondReviewer")
  auditLogs             AuditLog[]
  subscriptions         Subscription[]
  payments              Payment[]
  apiClients            ApiClient[]
  notifications         Notification[]
  dataSubjectRequests   DataSubjectRequest[]    @relation("DsrSubject")
  dataSubjectHandled    DataSubjectRequest[]    @relation("DsrHandler")
  planPricesCreated     PlanPrice[]
  qrTokensRevoked       QrToken[]
  identityReviewUploads IdentityReviewRequest[]

  @@index([status])
  @@map("users")
}

model Session {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String    @db.Uuid
  /// SHA-256 of the opaque session token; the token itself is only in the cookie.
  tokenHash     String    @unique @db.Char(64)
  mfaVerifiedAt DateTime? @db.Timestamptz(6)
  ipHash        String?   @db.Char(64)
  userAgent     String?   @db.VarChar(256)
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  lastSeenAt    DateTime  @default(now()) @db.Timestamptz(6)
  expiresAt     DateTime  @db.Timestamptz(6)
  revokedAt     DateTime? @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model MfaFactor {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String        @db.Uuid
  type         MfaFactorType @default(TOTP)
  secretEnc    Bytes
  lastUsedStep BigInt?
  confirmedAt  DateTime?     @db.Timestamptz(6)
  disabledAt   DateTime?     @db.Timestamptz(6)
  createdAt    DateTime      @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("mfa_factors")
}

model PhoneOtpChallenge {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phoneE164   String     @db.VarChar(16)
  purpose     OtpPurpose
  /// HMAC-SHA-256(pepper, challengeId || code). The code is never stored.
  codeHash    String     @db.Char(64)
  attempts    Int        @default(0)
  maxAttempts Int        @default(5)
  ipHash      String?    @db.Char(64)
  createdAt   DateTime   @default(now()) @db.Timestamptz(6)
  expiresAt   DateTime   @db.Timestamptz(6)
  consumedAt  DateTime?  @db.Timestamptz(6)

  badges SellerBadge[]

  @@index([phoneE164, createdAt])
  @@index([expiresAt])
  @@map("phone_otp_challenges")
}

/// Staff roles are granted by row, never by a column on User, so every grant
/// and revocation is attributable. One live grant per (user, role).
model StaffRoleAssignment {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String    @db.Uuid
  role        StaffRole
  grantedById String?   @db.Uuid
  grantedAt   DateTime  @default(now()) @db.Timestamptz(6)
  revokedAt   DateTime? @db.Timestamptz(6)
  revokedById String?   @db.Uuid

  user      User  @relation("RoleHolder", fields: [userId], references: [id], onDelete: Restrict)
  grantedBy User? @relation("RoleGrantor", fields: [grantedById], references: [id], onDelete: SetNull)
  revokedBy User? @relation("RoleRevoker", fields: [revokedById], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("staff_role_assignments")
}

// ─────────────────────────── Sellers & businesses ───────────────────────────

model SellerProfile {
  id               String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String              @unique @db.Uuid
  /// Public, random, non-sequential: "TMG-" + 10 Crockford base32 chars.
  tamagneId        String              @unique @db.VarChar(16)
  displayName      String              @db.VarChar(120)
  displayNameAm    String?             @db.VarChar(120)
  sellerType       SellerType
  accountStatus    SellerAccountStatus @default(ACTIVE)
  /// Public profile is shown only while PUBLIC_PROFILE_DISPLAY consent is granted.
  isPublic         Boolean             @default(false)
  region           String?             @db.VarChar(80)
  city             String?             @db.VarChar(80)
  suspendedAt      DateTime?           @db.Timestamptz(6)
  suspensionReason String?             @db.VarChar(1000)
  createdAt        DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime            @updatedAt @db.Timestamptz(6)
  deletedAt        DateTime?           @db.Timestamptz(6)

  user                   User                    @relation(fields: [userId], references: [id], onDelete: Restrict)
  business               Business?
  identityVerifications  IdentityVerification[]
  oidcAuthRequests       OidcAuthRequest[]
  badges                 SellerBadge[]
  verificationEvents     VerificationEvent[]
  qrTokens               QrToken[]
  fraudReports           FraudReport[]
  appeals                Appeal[]
  reviewRecords          ReviewRecord[]
  identityReviewRequests IdentityReviewRequest[]

  @@index([accountStatus])
  @@index([displayName])
  @@map("seller_profiles")
}

model Business {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerProfileId    String            @unique @db.Uuid
  legalName          String            @db.VarChar(200)
  tradeName          String?           @db.VarChar(200)
  legalForm          BusinessLegalForm
  registrationNumber String?           @db.VarChar(64)
  tinNumber          String?           @db.VarChar(32)
  region             String?           @db.VarChar(80)
  city               String?           @db.VarChar(80)
  status             BusinessStatus    @default(DRAFT)
  submittedAt        DateTime?         @db.Timestamptz(6)
  decidedAt          DateTime?         @db.Timestamptz(6)
  /// Reviewer's reason shown to the seller on rejection or change request.
  decisionReason     String?           @db.VarChar(2000)
  createdAt          DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime          @updatedAt @db.Timestamptz(6)

  sellerProfile SellerProfile      @relation(fields: [sellerProfileId], references: [id], onDelete: Restrict)
  documents     BusinessDocument[]

  @@index([status])
  @@map("businesses")
}

/// Files live in private object storage; the DB holds metadata only.
model BusinessDocument {
  id              String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId      String               @db.Uuid
  uploadedById    String               @db.Uuid
  type            BusinessDocumentType
  /// Server-generated key; never derived from the user's filename.
  storageKey      String               @unique @db.VarChar(256)
  mimeType        String               @db.VarChar(100)
  sizeBytes       Int
  sha256          String               @db.Char(64)
  scanStatus      MalwareScanStatus    @default(PENDING)
  scanEngine      String?              @db.VarChar(64)
  scannedAt       DateTime?            @db.Timestamptz(6)
  reviewStatus    DocumentReviewStatus @default(PENDING)
  rejectionReason String?              @db.VarChar(1000)
  retainUntil     DateTime?            @db.Timestamptz(6)
  purgedAt        DateTime?            @db.Timestamptz(6)
  createdAt       DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime             @updatedAt @db.Timestamptz(6)

  business   Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  uploadedBy User     @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([businessId])
  @@index([reviewStatus, scanStatus])
  @@map("business_documents")
}

// ─────────────────────────── Identity (Fayda) ───────────────────────────

/// One row per eSignet authorization attempt. Holds what the callback needs to
/// validate state, nonce and PKCE. Single use (consumedAt) and short-lived.
model OidcAuthRequest {
  id              String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String                 @db.Uuid
  sellerProfileId String                 @db.Uuid
  environment     IntegrationEnvironment
  stateHash       String                 @unique @db.Char(64)
  nonceHash       String                 @db.Char(64)
  codeVerifierEnc Bytes
  redirectUri     String                 @db.VarChar(512)
  consentRecordId String                 @db.Uuid
  createdAt       DateTime               @default(now()) @db.Timestamptz(6)
  expiresAt       DateTime               @db.Timestamptz(6)
  consumedAt      DateTime?              @db.Timestamptz(6)

  user          User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  sellerProfile SellerProfile          @relation(fields: [sellerProfileId], references: [id], onDelete: Cascade)
  consent       ConsentRecord          @relation(fields: [consentRecordId], references: [id], onDelete: Restrict)
  verifications IdentityVerification[]

  @@index([expiresAt])
  @@map("oidc_auth_requests")
}

/// Result of a Fayda eSignet authentication. Stores no biometric data and no
/// FIN/FAN in clear. `subjectHash` = HMAC-SHA-256(server pepper, provider subject).
model IdentityVerification {
  id                String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerProfileId   String                     @db.Uuid
  authRequestId     String?                    @db.Uuid
  provider          IdentityProvider           @default(FAYDA_ESIGNET)
  environment       IntegrationEnvironment
  status            IdentityVerificationStatus @default(INITIATED)
  subjectHash       String?                    @db.Char(64)
  issuer            String?                    @db.VarChar(512)
  audience          String?                    @db.VarChar(512)
  idTokenJti        String?                    @db.VarChar(256)
  acr               String?                    @db.VarChar(256)
  signatureVerified Boolean                    @default(false)
  /// Verified name as returned by the provider (encrypted). Shown only to the seller and reviewers.
  verifiedNameEnc   Bytes?
  failureCode       String?                    @db.VarChar(64)
  verifiedAt        DateTime?                  @db.Timestamptz(6)
  expiresAt         DateTime?                  @db.Timestamptz(6)
  revokedAt         DateTime?                  @db.Timestamptz(6)
  createdAt         DateTime                   @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime                   @updatedAt @db.Timestamptz(6)

  sellerProfile SellerProfile       @relation(fields: [sellerProfileId], references: [id], onDelete: Restrict)
  authRequest   OidcAuthRequest?    @relation(fields: [authRequestId], references: [id], onDelete: SetNull)
  badges        SellerBadge[]
  events        VerificationEvent[]

  @@index([sellerProfileId])
  @@map("identity_verifications")
}

model ConsentRecord {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String         @db.Uuid
  purpose          ConsentPurpose
  policyVersion    String         @db.VarChar(32)
  status           ConsentStatus  @default(GRANTED)
  locale           Locale
  grantedAt        DateTime       @default(now()) @db.Timestamptz(6)
  withdrawnAt      DateTime?      @db.Timestamptz(6)
  withdrawalReason String?        @db.VarChar(500)
  ipHash           String?        @db.Char(64)

  user             User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  oidcAuthRequests OidcAuthRequest[]

  @@index([userId, purpose])
  @@map("consent_records")
}

/// Interim manual identity review (while Fayda production access is pending).
/// Stores the ID document image encrypted in private storage; NO identity numbers are
/// recorded. The image is purged shortly after the decision (see retainUntil).
model IdentityReviewRequest {
  id              String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerProfileId String               @db.Uuid
  uploadedById    String               @db.Uuid
  documentType    IdentityDocumentType
  storageKey      String               @unique @db.VarChar(256)
  mimeType        String               @db.VarChar(100)
  sizeBytes       Int
  sha256          String               @db.Char(64)
  scanStatus      MalwareScanStatus    @default(PENDING)
  scanEngine      String?              @db.VarChar(64)
  scannedAt       DateTime?            @db.Timestamptz(6)
  status          IdentityReviewStatus @default(SUBMITTED)
  decisionReason  String?              @db.VarChar(2000)
  submittedAt     DateTime             @default(now()) @db.Timestamptz(6)
  decidedAt       DateTime?            @db.Timestamptz(6)
  retainUntil     DateTime?            @db.Timestamptz(6)
  purgedAt        DateTime?            @db.Timestamptz(6)
  createdAt       DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime             @updatedAt @db.Timestamptz(6)

  sellerProfile SellerProfile @relation(fields: [sellerProfileId], references: [id], onDelete: Restrict)
  uploadedBy    User          @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([sellerProfileId])
  @@index([status, submittedAt])
  @@map("identity_review_requests")
}

// ──────────────────────── Verification state ────────────────────────

/// One row per verification level grant. Status, dates, method, evidence and
/// revocation all live here; history lives in VerificationEvent.
model SellerBadge {
  id                     String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerProfileId        String             @db.Uuid
  level                  VerificationLevel
  status                 BadgeStatus        @default(PENDING)
  method                 VerificationMethod
  /// Evidence references (exactly the one matching `level` is required).
  phoneOtpChallengeId    String?            @db.Uuid
  identityVerificationId String?            @db.Uuid
  reviewRecordId         String?            @db.Uuid
  issuedAt               DateTime?          @db.Timestamptz(6)
  expiresAt              DateTime?          @db.Timestamptz(6)
  revokedAt              DateTime?          @db.Timestamptz(6)
  revokedById            String?            @db.Uuid
  revocationReason       String?            @db.VarChar(1000)
  createdAt              DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime           @updatedAt @db.Timestamptz(6)

  sellerProfile        SellerProfile         @relation(fields: [sellerProfileId], references: [id], onDelete: Restrict)
  phoneOtpChallenge    PhoneOtpChallenge?    @relation(fields: [phoneOtpChallengeId], references: [id], onDelete: Restrict)
  identityVerification IdentityVerification? @relation(fields: [identityVerificationId], references: [id], onDelete: Restrict)
  reviewRecord         ReviewRecord?         @relation(fields: [reviewRecordId], references: [id], onDelete: Restrict)
  revokedBy            User?                 @relation(fields: [revokedById], references: [id], onDelete: SetNull)
  events               VerificationEvent[]

  @@index([sellerProfileId, level])
  @@index([status, expiresAt])
  @@map("seller_badges")
}

/// Append-only (enforced by trigger). Never contains raw identity data.
model VerificationEvent {
  id                     String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerProfileId        String                @db.Uuid
  badgeId                String?               @db.Uuid
  identityVerificationId String?               @db.Uuid
  level                  VerificationLevel
  type                   VerificationEventType
  actorType              ActorType
  actorUserId            String?               @db.Uuid
  reason                 String?               @db.VarChar(1000)
  metadata               Json                  @default("{}")
  createdAt              DateTime              @default(now()) @db.Timestamptz(6)

  sellerProfile        SellerProfile         @relation(fields: [sellerProfileId], references: [id], onDelete: Restrict)
  badge                SellerBadge?          @relation(fields: [badgeId], references: [id], onDelete: Restrict)
  identityVerification IdentityVerification? @relation(fields: [identityVerificationId], references: [id], onDelete: Restrict)
  actorUser            User?                 @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([sellerProfileId, createdAt])
  @@index([badgeId])
  @@map("verification_events")
}

/// Public QR identifiers: 256-bit random, base64url, revocable, rotatable.
model QrToken {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerProfileId String        @db.Uuid
  token           String        @unique @db.VarChar(64)
  status          QrTokenStatus @default(ACTIVE)
  createdAt       DateTime      @default(now()) @db.Timestamptz(6)
  revokedAt       DateTime?     @db.Timestamptz(6)
  revokedById     String?       @db.Uuid
  revokedReason   String?       @db.VarChar(500)

  sellerProfile SellerProfile @relation(fields: [sellerProfileId], references: [id], onDelete: Restrict)
  revokedBy     User?         @relation(fields: [revokedById], references: [id], onDelete: SetNull)

  @@index([sellerProfileId])
  @@map("qr_tokens")
}

// ─────────────────────── Trust & safety, reviews ───────────────────────

model FraudReport {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerProfileId    String              @db.Uuid
  reporterUserId     String?             @db.Uuid
  /// Optional contact for anonymous reporters (encrypted).
  reporterContactEnc Bytes?
  reporterIpHash     String?             @db.Char(64)
  category           FraudReportCategory
  description        String              @db.VarChar(5000)
  status             FraudReportStatus   @default(SUBMITTED)
  assignedToId       String?             @db.Uuid
  resolutionNote     String?             @db.VarChar(2000)
  resolvedAt         DateTime?           @db.Timestamptz(6)
  createdAt          DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime            @updatedAt @db.Timestamptz(6)

  sellerProfile SellerProfile @relation(fields: [sellerProfileId], references: [id], onDelete: Restrict)
  reporter      User?         @relation("FraudReporter", fields: [reporterUserId], references: [id], onDelete: SetNull)
  assignedTo    User?         @relation("FraudAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([sellerProfileId])
  @@index([status, createdAt])
  @@map("fraud_reports")
}

model Appeal {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerProfileId String        @db.Uuid
  submittedById   String        @db.Uuid
  subjectType     AppealSubject
  subjectId       String?       @db.Uuid
  reason          String        @db.VarChar(5000)
  status          AppealStatus  @default(SUBMITTED)
  assignedToId    String?       @db.Uuid
  decidedById     String?       @db.Uuid
  decisionNote    String?       @db.VarChar(2000)
  decidedAt       DateTime?     @db.Timestamptz(6)
  createdAt       DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @db.Timestamptz(6)

  sellerProfile SellerProfile @relation(fields: [sellerProfileId], references: [id], onDelete: Restrict)
  submittedBy   User          @relation("AppealSubmitter", fields: [submittedById], references: [id], onDelete: Restrict)
  assignedTo    User?         @relation("AppealAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  decidedBy     User?         @relation("AppealDecider", fields: [decidedById], references: [id], onDelete: Restrict)

  @@index([sellerProfileId])
  @@index([status, createdAt])
  @@map("appeals")
}

/// A reviewer decision. HIGH-risk decisions need a different second reviewer
/// before they become FINAL (enforced by CHECK constraints).
model ReviewRecord {
  id                   String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerProfileId      String           @db.Uuid
  targetType           ReviewTargetType
  targetId             String           @db.Uuid
  reviewerId           String           @db.Uuid
  decision             ReviewDecision
  reason               String           @db.VarChar(2000)
  riskLevel            RiskLevel        @default(LOW)
  requiresSecondReview Boolean          @default(false)
  status               ReviewStatus     @default(FINAL)
  secondReviewerId     String?          @db.Uuid
  secondDecision       ReviewDecision?
  secondReason         String?          @db.VarChar(2000)
  secondReviewedAt     DateTime?        @db.Timestamptz(6)
  finalizedAt          DateTime?        @db.Timestamptz(6)
  createdAt            DateTime         @default(now()) @db.Timestamptz(6)

  sellerProfile  SellerProfile @relation(fields: [sellerProfileId], references: [id], onDelete: Restrict)
  reviewer       User          @relation("PrimaryReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)
  secondReviewer User?         @relation("SecondReviewer", fields: [secondReviewerId], references: [id], onDelete: Restrict)
  badges         SellerBadge[]

  @@index([targetType, targetId])
  @@index([sellerProfileId])
  @@index([status])
  @@map("review_records")
}

/// Append-only, hash-chained (each row's hash covers the previous row's hash).
model AuditLog {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  seq              BigInt    @unique @default(autoincrement())
  occurredAt       DateTime  @default(now()) @db.Timestamptz(6)
  actorType        ActorType
  actorUserId      String?   @db.Uuid
  actorApiClientId String?   @db.Uuid
  action           String    @db.VarChar(100)
  targetType       String?   @db.VarChar(64)
  targetId         String?   @db.VarChar(64)
  requestId        String?   @db.VarChar(64)
  ipHash           String?   @db.Char(64)
  metadata         Json      @default("{}")
  prevHash         String?   @db.Char(64)
  hash             String?   @db.Char(64)

  actorUser      User?      @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  actorApiClient ApiClient? @relation(fields: [actorApiClientId], references: [id], onDelete: Restrict)

  @@index([actorUserId, occurredAt])
  @@index([targetType, targetId])
  @@index([action, occurredAt])
  @@map("audit_logs")
}

// ──────────────────────────── Billing ────────────────────────────

/// Admin-configurable catalogue. No prices live in code.
model Plan {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String   @unique @db.VarChar(64)
  kind      PlanKind
  nameEn    String   @db.VarChar(120)
  nameAm    String   @db.VarChar(120)
  isActive  Boolean  @default(true)
  /// Feature limits (e.g. API calls/month). Never used to grant verification.
  limits    Json     @default("{}")
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  prices        PlanPrice[]
  subscriptions Subscription[]
  apiClients    ApiClient[]

  @@map("plans")
}

/// Prices are versioned: a price is closed (validTo) and a new row inserted.
model PlanPrice {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  planId      String          @db.Uuid
  amount      Decimal         @db.Decimal(14, 2)
  currency    String          @default("ETB") @db.Char(3)
  interval    BillingInterval
  validFrom   DateTime        @default(now()) @db.Timestamptz(6)
  validTo     DateTime?       @db.Timestamptz(6)
  createdById String?         @db.Uuid
  createdAt   DateTime        @default(now()) @db.Timestamptz(6)

  plan          Plan           @relation(fields: [planId], references: [id], onDelete: Restrict)
  createdBy     User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)
  subscriptions Subscription[]

  @@index([planId])
  @@map("plan_prices")
}

model Subscription {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String             @db.Uuid
  planId             String             @db.Uuid
  planPriceId        String             @db.Uuid
  status             SubscriptionStatus
  currentPeriodStart DateTime           @db.Timestamptz(6)
  currentPeriodEnd   DateTime?          @db.Timestamptz(6)
  cancelAtPeriodEnd  Boolean            @default(false)
  canceledAt         DateTime?          @db.Timestamptz(6)
  provider           String?            @db.VarChar(32)
  providerRef        String?            @db.VarChar(128)
  createdAt          DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime           @updatedAt @db.Timestamptz(6)

  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  plan      Plan      @relation(fields: [planId], references: [id], onDelete: Restrict)
  planPrice PlanPrice @relation(fields: [planPriceId], references: [id], onDelete: Restrict)
  payments  Payment[]

  @@unique([provider, providerRef])
  @@index([userId, status])
  @@map("subscriptions")
}

/// Payments have no relation to verification tables by design:
/// paying can never create, extend or restore a verification badge.
model Payment {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String        @db.Uuid
  subscriptionId    String?       @db.Uuid
  amount            Decimal       @db.Decimal(14, 2)
  currency          String        @default("ETB") @db.Char(3)
  status            PaymentStatus @default(PENDING)
  provider          String        @db.VarChar(32)
  providerReference String        @db.VarChar(128)
  failureReason     String?       @db.VarChar(500)
  paidAt            DateTime?     @db.Timestamptz(6)
  createdAt         DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime      @updatedAt @db.Timestamptz(6)

  user         User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@unique([provider, providerReference])
  @@index([userId, createdAt])
  @@map("payments")
}

// ─────────────────────── Marketplace API & messaging ───────────────────────

model ApiClient {
  id                 String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerUserId        String          @db.Uuid
  planId             String?         @db.Uuid
  name               String          @db.VarChar(120)
  /// First characters of the key, shown in the UI to identify it.
  keyPrefix          String          @unique @db.VarChar(16)
  /// SHA-256 of the full API key; the key is shown once at creation.
  keyHash            String          @unique @db.Char(64)
  scopes             String[]
  ipAllowlist        String[]
  rateLimitPerMinute Int             @default(60)
  status             ApiClientStatus @default(ACTIVE)
  lastUsedAt         DateTime?       @db.Timestamptz(6)
  revokedAt          DateTime?       @db.Timestamptz(6)
  createdAt          DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime        @updatedAt @db.Timestamptz(6)

  owner     User       @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  plan      Plan?      @relation(fields: [planId], references: [id], onDelete: SetNull)
  auditLogs AuditLog[]

  @@index([ownerUserId])
  @@map("api_clients")
}

model Notification {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String              @db.Uuid
  channel       NotificationChannel
  templateKey   String              @db.VarChar(100)
  locale        Locale
  /// Template variables only; never secrets, OTP codes or identity data.
  payload       Json                @default("{}")
  status        NotificationStatus  @default(QUEUED)
  failureReason String?             @db.VarChar(500)
  createdAt     DateTime            @default(now()) @db.Timestamptz(6)
  sentAt        DateTime?           @db.Timestamptz(6)
  readAt        DateTime?           @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status])
  @@map("notifications")
}

// ─────────────────────────── Privacy ───────────────────────────

/// Data-subject requests under Proclamation No. 1321/2024 (access, correction, deletion).
model DataSubjectRequest {
  id          String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String                   @db.Uuid
  type        DataSubjectRequestType
  status      DataSubjectRequestStatus @default(RECEIVED)
  details     String?                  @db.VarChar(2000)
  handledById String?                  @db.Uuid
  outcome     String?                  @db.VarChar(2000)
  dueAt       DateTime                 @db.Timestamptz(6)
  completedAt DateTime?                @db.Timestamptz(6)
  createdAt   DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime                 @updatedAt @db.Timestamptz(6)

  user      User  @relation("DsrSubject", fields: [userId], references: [id], onDelete: Restrict)
  handledBy User? @relation("DsrHandler", fields: [handledById], references: [id], onDelete: SetNull)

  @@index([status, dueAt])
  @@map("data_subject_requests")
}
