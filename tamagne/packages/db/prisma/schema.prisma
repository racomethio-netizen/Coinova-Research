  SHARE_COMPANY
  PARTNERSHIP
  COOPERATIVE
  OTHER
}

enum BusinessStatus {
  DRAFT
  SUBMITTED
  VERIFIED
  REJECTED
  SUSPENDED
}

enum BusinessDocumentType {
