/// Verification categories. Levels 1–4 are the public ladder.
/// IDENTITY_MANUAL_REVIEW is the interim manual identity check used while
/// official Fayda production access is pending. It is displayed as
/// "Identity reviewed manually" and is NEVER displayed as Fayda verification.
enum VerificationLevel {
  PHONE // Level 1
  FAYDA_IDENTITY // Level 2
  BUSINESS_DOCUMENTS // Level 3
  ENHANCED_REVIEW // Level 4
  IDENTITY_MANUAL_REVIEW
}

enum VerificationMethod {
  PHONE_OTP
  FAYDA_ESIGNET_OIDC
  MANUAL_IDENTITY_REVIEW
  MANUAL_DOCUMENT_REVIEW
  ENHANCED_BUSINESS_REVIEW
}

enum BadgeStatus {
  PENDING
  ACTIVE
  SUSPENDED
  EXPIRED
  REVOKED
}

enum IdentityProvider {
  FAYDA_ESIGNET
}

enum IntegrationEnvironment {
  SANDBOX
  PRODUCTION
}

enum IdentityVerificationStatus {
  INITIATED
  VERIFIED
  FAILED
  REVOKED
  EXPIRED
}

enum VerificationEventType {
  REQUESTED
  SUBMITTED
  APPROVED
  REJECTED
  ISSUED
  RENEWED
  EXPIRED
  SUSPENDED
  REINSTATED
  REVOKED
  FAILED
}

enum ActorType {
  USER
  STAFF
  SYSTEM
  API_CLIENT
}

enum ConsentPurpose {
  TERMS_OF_SERVICE
  PRIVACY_POLICY
  FAYDA_IDENTITY_VERIFICATION
