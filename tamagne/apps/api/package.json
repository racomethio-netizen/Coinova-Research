{
  "name": "@tamagne/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node --enable-source-maps dist/main.js",
    "dev": "tsx watch --env-file-if-exists=../../.env --conditions=tamagne-source src/main.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "openapi": "tsx --conditions=tamagne-source scripts/export-openapi.ts",
    "staff:bootstrap": "tsx --conditions=tamagne-source scripts/bootstrap-super-admin.ts",
    "test:redis": "REDIS_TEST_URL=${REDIS_TEST_URL:-redis://127.0.0.1:6379/0} vitest run test/rate-limit.test.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "@nestjs/swagger": "12.0.3",
    "@tamagne/core": "0.1.0",
    "@tamagne/db": "0.1.0",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "jose": "6.2.13",
    "qrcode": "1.5.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "12.2.0",
    "@swc/core": "1.16.20",
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "@types/node": "22.20.5",
    "@types/qrcode": "1.5.6",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "unplugin-swc": "2.0.0",
    "vitest": "4.1.12"
  }
}
