# TAMAGNE environment variables. Copy to .env for LOCAL DEVELOPMENT ONLY.
# Never commit .env. In staging/production every secret comes from the secrets
# manager (docs/DEPLOYMENT.md) and the dev placeholders below are rejected at startup.

# ── Runtime ──
# development | test | staging | production
APP_ENV=development
PORT=4000
PUBLIC_WEB_URL=http://localhost:3000
# Comma-separated exact origins; https only in production.
CORS_ORIGINS=http://localhost:3000
# Serves /api/docs. Must be false in production (publish docs/api/openapi.json instead).
OPENAPI_ENABLED=true
# Number of trusted reverse proxies in front of the API.
TRUST_PROXY_HOPS=0

# ── Database (PostgreSQL 16) ── production requires sslmode=verify-full
POSTGRES_PASSWORD=dev-only-change-me
DATABASE_URL=postgresql://tamagne:dev-only-change-me@localhost:5432/tamagne

# ── Redis (rate limits, OTP throttling, job queues from Phase 2) ──
REDIS_PASSWORD=dev-only-change-me
REDIS_URL=redis://:dev-only-change-me@localhost:6379/0

# ── Application-level encryption ──
# Generate each key with:  openssl rand -base64 32
# Key ring format "<id>:<base64>,<id>:<base64>"; keep retired keys until data is re-encrypted.
FIELD_ENCRYPTION_KEYS=1:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
FIELD_ENCRYPTION_ACTIVE_KEY_ID=1
# Pepper for HMACs of identity subjects, OTP codes and IP addresses.
HMAC_PEPPER=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# ── Fayda eSignet (OIDC) ──
# Disabled by default: identity checks then use the manual review workflow.
# "sandbox" only with credentials issued for the sandbox; "production" only with
# officially authorized production credentials and APP_ENV=production.
# Read docs/FAYDA_INTEGRATION.md before changing anything here.
FAYDA_MODE=disabled
FAYDA_ISSUER=
FAYDA_CLIENT_ID=
FAYDA_REDIRECT_URI=
# Private JWK (one-line JSON) for private_key_jwt. From the secrets manager only; never commit.
FAYDA_CLIENT_PRIVATE_KEY_JWK=
FAYDA_SCOPES=openid profile
FAYDA_ACR_VALUES=
FAYDA_CLAIMS_LOCALES=en am
