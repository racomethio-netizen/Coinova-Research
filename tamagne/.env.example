# TAMAGNE environment variables. Copy to .env for LOCAL DEVELOPMENT ONLY.
# Never commit .env. In staging/production every secret comes from the secrets
# manager (docs/DEPLOYMENT.md) and the dev placeholders below are rejected at startup.

# ── Runtime ──
# development | test | staging | production
APP_ENV=development
PORT=4000
PUBLIC_WEB_URL=http://localhost:3000
# Comma-separated exact origins; https only in production.
CORS_ORIGINS=http://localhost:3000
# Serves /api/docs. Must be false in production (publish docs/api/openapi.json instead).
OPENAPI_ENABLED=true
# Number of trusted reverse proxies in front of the API (the web proxy counts as one).
TRUST_PROXY_HOPS=0

# ── SMS for phone OTP ──
# disabled | console (development only: prints codes to the API log) | test (APP_ENV=test only)
# A production provider (Ethio telecom is under consideration) is added once a contract exists.
SMS_PROVIDER=console
# OTP sends per IP per 15 min (generous: mobile carriers share IPs). Per-phone limits stay strict.
OTP_SEND_LIMIT_PER_IP=30
# Days to answer access/correction requests, and the grace period before an account
# deletion is carried out. Confirm the statutory periods with counsel.
DSR_RESPONSE_DAYS=30
DELETION_GRACE_DAYS=14
# Public verification lookups per IP per minute.
VERIFY_LOOKUP_LIMIT_PER_MIN=120
# Accept synthetic +999 numbers for local testing. Rejected in production.
ALLOW_TEST_PHONE_NUMBERS=true

# ── Business documents ──
# disabled | local (development/test only: AES-256-GCM encrypted files under STORAGE_LOCAL_DIR).
# Production needs Ethiopia-hosted S3-compatible object storage (adapter added once a provider is chosen).
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.tmp/storage
# disabled | clamav | eicar-only (development/test only; detects the EICAR test file, NOT real malware)
SCANNER=eicar-only
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310

# ── Observability ──
# json (one object per line) | text. Default: text in development/test, json elsewhere.
LOG_FORMAT=text
# Bearer token for GET /api/v1/metrics (Prometheus). Empty → endpoint returns 404. ≥ 32 chars.
METRICS_TOKEN=

# ── Web app ──
# Where the web server reaches the API (read at runtime by the /api proxy route).
API_INTERNAL_URL=http://127.0.0.1:4000

# ── Database (PostgreSQL 16) ── production requires sslmode=verify-full
POSTGRES_PASSWORD=dev-only-change-me
DATABASE_URL=postgresql://tamagne:dev-only-change-me@localhost:5432/tamagne

# ── Redis (rate limits, OTP throttling, job queues from Phase 2) ──
REDIS_PASSWORD=dev-only-change-me
REDIS_URL=redis://:dev-only-change-me@localhost:6379/0

# ── Application-level encryption ──
# Generate each key with:  openssl rand -base64 32
# Key ring format "<id>:<base64>,<id>:<base64>"; keep retired keys until data is re-encrypted.
FIELD_ENCRYPTION_KEYS=1:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
FIELD_ENCRYPTION_ACTIVE_KEY_ID=1
# Pepper for HMACs of identity subjects, OTP codes and IP addresses.
HMAC_PEPPER=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# ── Fayda eSignet (OIDC) ──
# Disabled by default: identity checks then use the manual review workflow.
# "sandbox" only with credentials issued for the sandbox; "production" only with
# officially authorized production credentials and APP_ENV=production.
# Read docs/FAYDA_INTEGRATION.md before changing anything here.
FAYDA_MODE=disabled
FAYDA_ISSUER=
FAYDA_CLIENT_ID=
FAYDA_REDIRECT_URI=
# Private JWK (one-line JSON) for private_key_jwt. From the secrets manager only; never commit.
FAYDA_CLIENT_PRIVATE_KEY_JWK=
FAYDA_SCOPES=openid profile
FAYDA_ACR_VALUES=
FAYDA_CLAIMS_LOCALES=en am
# Userinfo claims to request (space-separated). Never biometrics (picture) or ID numbers.
FAYDA_USERINFO_CLAIMS=name
