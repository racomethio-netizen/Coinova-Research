# NEXUS AI environment template. Copy to .env (never commit .env).
# Generate secrets with:  scripts/generate-secrets.sh

# --- Infrastructure -----------------------------------------------------------
# Use hex secrets (no URL-special characters): openssl rand -hex 24
POSTGRES_PASSWORD=
REDIS_PASSWORD=
POSTGRES_HOST_PORT=5433
API_HOST_PORT=8000

# --- Application --------------------------------------------------------------
NEXUS_APP_ENV=development          # development | staging | production
NEXUS_LOG_LEVEL=INFO

# "<key_id>:<base64url 32 bytes>", comma separated; the first one encrypts.
NEXUS_CREDENTIAL_ENCRYPTION_KEYS=
NEXUS_SESSION_SECRET=

# --- Trading (paper by default) -------------------------------------------------
NEXUS_TRADING_MODE=paper
# Live trading needs ALL of: trading_mode=live, live_trading_enabled=true, the exact
# acknowledgement phrase (see docs/SECURITY.md), app_env=production, and a recorded
# owner approval in the database. Leave these alone until you have decided.
NEXUS_LIVE_TRADING_ENABLED=false
NEXUS_LIVE_TRADING_ACK=
NEXUS_ENABLED_EXCHANGES=binance,kraken,coinbase
NEXUS_TRADING_PAIRS=BTC/USDT,ETH/USDT
NEXUS_TIMEFRAMES=5m,15m,1h,4h
NEXUS_USE_EXCHANGE_SANDBOX=false

# Risk limits may only be made STRICTER than these (startup fails otherwise).
# NEXUS_RISK__RISK_PER_TRADE=0.0025
# NEXUS_RISK__DAILY_LOSS_LIMIT=0.01
# NEXUS_RISK__WEEKLY_LOSS_LIMIT=0.02
# NEXUS_RISK__MAX_DRAWDOWN=0.05
# NEXUS_RISK__MAX_OPEN_POSITIONS=2
# NEXUS_RISK__MAX_PORTFOLIO_EXPOSURE=0.50

# --- Notifications --------------------------------------------------------------
NEXUS_TELEGRAM_BOT_TOKEN=
NEXUS_TELEGRAM_CHAT_ID=

# Exchange API keys are NOT configured here. They are entered through the dashboard
# (Phase 11/13), encrypted with NEXUS_CREDENTIAL_ENCRYPTION_KEYS, and stored in the DB.
# Optional: extra CA bundle for image builds behind a TLS-inspecting proxy
EXTRA_CA_FILE=
