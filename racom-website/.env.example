# Racom Technology website — environment variables.
# Copy to .env.local for development. Never commit real values.
# Only variables prefixed NEXT_PUBLIC_ reach the browser; none of them are secrets.

# Public origin of the deployed site, without a trailing slash.
# Enables canonical URLs, absolute Open Graph URLs, sitemap URLs and HSTS (when https).
# Leave empty in development.
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------------------
# Project inquiry delivery (contact form) — server-only.
# The form sends inquiries by email through Resend (https://resend.com).
# All three values are required for delivery. If any is missing:
#   - development: the inquiry is saved to ./.data/inquiries/ and the form says
#     so explicitly (it never claims the inquiry was emailed);
#   - production:  the endpoint answers 503 and the form shows an error with
#     alternative contact options. Nothing is silently discarded.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
# Sender on a domain you have verified in Resend, e.g. "Racom Website <website@your-domain>".
CONTACT_FROM_EMAIL=
# Inbox that receives inquiries. Comma-separate for several recipients.
CONTACT_TO_EMAIL=

# Rate limit for the inquiry endpoint, per client IP (defaults: 5 per 600 seconds).
CONTACT_RATE_LIMIT_MAX=5
CONTACT_RATE_LIMIT_WINDOW_SECONDS=600
